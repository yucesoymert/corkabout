# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
AUTH_SECRET=            # npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Vercel Marketplace → Neon (adds it to the project on its own)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Vercel Storage → Blob (public store; "add a read-write token" when connecting)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Photo limits (src/lib/limits.ts): these accounts have no limit, comma separated
UNLIMITED_EMAILS=
# Daily orphan photo cleanup (src/app/api/cron/photos): Vercel sends it as a Bearer token
CRON_SECRET=
